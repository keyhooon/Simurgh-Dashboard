<!--  1. SimurghDashboard/Resources/DataTemplates.xaml  -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels1="clr-namespace:Simurgh.Dashboard.Clock.ViewModels"
    xmlns:controls="clr-namespace:Simurgh.Dashboard.Clock.Controls">

    <!--
        Implicit DataTemplates (No x:Key):
        WPF's presentation engine automatically uses these templates whenever it encounters
        the specified ViewModel type in the visual tree (e.g., assigned to a ContentControl.Content).
        This forms the backbone of View-Model decoupling in our MVVM architecture.
    -->

    <!--  ============================================================  -->

    <DataTemplate DataType="{x:Type viewmodels1:DigitalClockViewModel}">

        <controls:DigitalClockControl
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            DateBrush="{Binding DateBrush}"
            DigitBrush="{Binding DigitBrush}"
            PlaceholderBrush="{Binding PlaceholderBrush}"
            ShowSeconds="{Binding ShowSeconds}"
            WeatherState="{Binding WeatherState}" />

    </DataTemplate>

</ResourceDictionary>
