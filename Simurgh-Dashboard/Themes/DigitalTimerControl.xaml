<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:SimurghDashboard.Controls"
    xmlns:controls1="clr-namespace:SimurghDashboard.Timers.Controls"
    xmlns:timers1="clr-namespace:SimurghDashboard.Timers.Controls.Timers">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SimurghDashboard;component/Themes/Icons.xaml" />
        <ResourceDictionary Source="/SimurghDashboard;component/Themes/Fonts.xaml" />
        <ResourceDictionary Source="/SimurghDashboard;component/Themes/Images.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="{x:Type controls1:DigitalTimerControl}">
        <Setter Property="Padding" Value="40" />
        <Setter Property="PlaceholderBrush" Value="#20263238" />
        <Setter Property="DigitBrush" Value="#63D7FF" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls1:DigitalTimerControl}">
                    <Grid>
                        <!--  LAYER 1: Background  -->
                        <controls:NineSliceBorder
                            x:Name="PART_Frame"
                            IsHitTestVisible="False"
                            SliceThickness="60"
                            Source="{StaticResource ImgPanelRoundedRaised}" />

                        <!--  LAYER 2: Main Content  -->
                        <Grid
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  Section A: Header (ID Badge + Title)  -->
                            <Grid Grid.Row="0" Margin="10,0,10,15">

                                <!--  Timer Title  -->
                                <TextBlock
                                    x:Name="PART_Title"
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource FontFamilyApp}"
                                    FontSize="28"
                                    FontWeight="SemiBold"
                                    Foreground="{TemplateBinding Foreground}"
                                    Text="{TemplateBinding Title}"
                                    TextAlignment="Left"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>


                            <!--  Section B: Digital Display Area  -->
                            <Border
                                Grid.Row="1"
                                Padding="15"
                                VerticalAlignment="Center"
                                Background="#CC000000"
                                BorderBrush="#33FFFFFF"
                                BorderThickness="1"
                                CornerRadius="8">

                                <Grid x:Name="PART_TimeContainer" ClipToBounds="False">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Name="PART_PlaceholderText"
                                        Grid.Column="1"
                                        HorizontalAlignment="Center"
                                        FontFamily="{StaticResource FontFamilyDigit}"
                                        FontSize="52"
                                        FontStretch="UltraExpanded"
                                        FontWeight="ExtraBold"
                                        Foreground="{TemplateBinding PlaceholderBrush}"
                                        Text="{TemplateBinding PlaceholderText}"
                                        TextOptions.TextFormattingMode="Display" />
                                    <!--  TimeText is assumed to be a ReadOnly DP on the control itself, so TemplateBinding is correct  -->
                                    <TextBlock
                                        x:Name="PART_TimeText"
                                        Grid.Column="1"
                                        HorizontalAlignment="Center"
                                        FontFamily="{StaticResource FontFamilyDigit}"
                                        FontSize="52"
                                        FontStretch="UltraExpanded"
                                        FontWeight="ExtraBold"
                                        Foreground="{TemplateBinding DigitBrush}"
                                        Text="{TemplateBinding TimeText}"
                                        TextOptions.TextFormattingMode="Display" />
                                    <StackPanel Grid.Column="0" Orientation="Vertical">
                                        <Path
                                            x:Name="PART_DirectionIcon"
                                            Width="20"
                                            Height="20"
                                            Margin="0,3,0,0"
                                            VerticalAlignment="Center"
                                            Data="{StaticResource IconTimerDown}"
                                            Fill="{TemplateBinding DigitBrush}"
                                            Stretch="Uniform" />
                                        <Path
                                            x:Name="PART_StateIcon"
                                            Width="20"
                                            Height="20"
                                            Margin="0,3,0,0"
                                            VerticalAlignment="Center"
                                            Data="{StaticResource IconClock}"
                                            Fill="{TemplateBinding DigitBrush}"
                                            Stretch="Uniform" />
                                        
                                    </StackPanel>
                                    <!--  Timer ID Badge  -->
                                    <Border
                                        Grid.Column="2"
                                        Margin="0,0,12,0"
                                        Padding="10,3"
                                        VerticalAlignment="Top"
                                       
                                        BorderBrush="#33FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                        <TextBlock
                                            x:Name="PART_Id"
                                            FontFamily="{StaticResource FontFamilyDigit}"
                                            FontSize="18"
                                            FontWeight="Bold"
                                            Foreground="{TemplateBinding DigitBrush}"
                                            Text="{TemplateBinding Id}"
                                            TextAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Border>

                            <!--  Section C: Footer Status  -->
                            <StackPanel
                                x:Name="PART_StatePanel"
                                Grid.Row="2"
                                Margin="0,15,0,0"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource FontFamilyApp}"
                                           x:Name="PART_StateText"
                                           FontSize="18"
                                           FontWeight="ExtraBold"
                                           Foreground="#90A4AE"
                                           Text="توقف" />
                                <Ellipse
                                    x:Name="PART_StatusIndicator"
                                    Width="10"
                                    Height="10"
                                    Margin="8,0,8,0"
                                    Fill="#607D8B" />

        
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!--  Changed Trigger to DataTrigger to observe Configuration.Mode instead of a direct DP  -->
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Direction}" Value="CountUp">
                            <Setter TargetName="PART_DirectionIcon" Property="Data" Value="{StaticResource IconTimerUp}" />
                        </DataTrigger>

                        <!--  State is assumed to be a DP on the control itself, so simple Trigger works  -->
                        <Trigger Property="State" Value="{x:Static timers1:DigitalTimerState.Running}">
                            <Setter TargetName="PART_StateText" Property="Text" Value="اجرا" />
                            <Setter TargetName="PART_StateText" Property="Foreground" Value="#4CAF50" />
                            <Setter TargetName="PART_StatusIndicator" Property="Fill" Value="#4CAF50" />
                            <Setter TargetName="PART_StateIcon" Property="Data" Value="{StaticResource IconTimerRunning}" />
                            <Setter TargetName="PART_StateIcon" Property="Fill" Value="#4CAF50" />
                        </Trigger>

                        <Trigger Property="State" Value="{x:Static timers1:DigitalTimerState.Pausing}">
                            <Setter TargetName="PART_StateText" Property="Text" Value="توقف" />
                            <Setter TargetName="PART_StateText" Property="Foreground" Value="#FFC107" />
                            <Setter TargetName="PART_StatusIndicator" Property="Fill" Value="#FFC107" />
                            <Setter TargetName="PART_TimeText" Property="Foreground" Value="#FFC107" />
                            <Setter TargetName="PART_StateIcon" Property="Data" Value="{StaticResource IconTimerPause}" />
                            <Setter TargetName="PART_StateIcon" Property="Fill" Value="#FFC107" />
                        </Trigger>

                        <Trigger Property="State" Value="{x:Static timers1:DigitalTimerState.NotRunning}">
                            <Setter TargetName="PART_StateText" Property="Text" Value="پایان" />
                            <Setter TargetName="PART_StateText" Property="Foreground" Value="#03A9F4" />
                            <Setter TargetName="PART_StatusIndicator" Property="Fill" Value="#03A9F4" />
                            <Setter TargetName="PART_TimeText" Property="Foreground" Value="#03A9F4" />
                            <Setter TargetName="PART_StateIcon" Property="Data" Value="{StaticResource IconTimerComplete}" />
                            <Setter TargetName="PART_StateIcon" Property="Fill" Value="#03A9F4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
