<!-- RssTickerStyles.xaml -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:SimurghDashboard.Controls">

    <!-- Theme Dictionaries -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SimurghDashboard;component/Themes/Icons.xaml" />
        <ResourceDictionary Source="/SimurghDashboard;component/Themes/Fonts.xaml" />
        <ResourceDictionary Source="/SimurghDashboard;component/Themes/Images.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="{x:Type local:MarqueeItemsControl}">
        <Setter Property="Padding" Value="40,10" />
        <Setter Property="FlowDirection" Value="RightToLeft" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyApp}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="#FFB74D" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Title" Value="اخبار سیمرغ" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:MarqueeItemsControl}">
                    <Grid>
                        <local:NineSliceBorder
                            x:Name="PART_Frame"
                            IsHitTestVisible="False"
                            RenderOptions.BitmapScalingMode="Fant"
                            SliceThickness="60,60,60,60"
                            Source="{StaticResource ImgPanelRoundedRaised}" />

                        <!-- Removed Margin="{TemplateBinding Padding}" from this Border -->
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Title Panel -->
                                <Border
                                    Grid.Column="0"
                                    Margin="15,15,15,0"
                                    Padding="15,5"
                                    VerticalAlignment="Top"
                                    CornerRadius="8">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Bind Path Fill to Foreground so icon matches the text color -->
                                        <Path
                                            Width="16"
                                            Height="16"
                                            Margin="0,0,8,0"
                                            Data="{StaticResource IconBroadcast}"
                                            Fill="{TemplateBinding Foreground}"
                                            Stretch="Uniform" />

                                        <!-- Font properties bound to the parent control's properties -->
                                        <TextBlock
                                            FontFamily="{TemplateBinding FontFamily}"
                                            FontSize="{TemplateBinding FontSize}"
                                            FontWeight="{TemplateBinding FontWeight}"
                                            Foreground="{TemplateBinding Foreground}"
                                            Text="{TemplateBinding Title}" />
                                    </StackPanel>
                                </Border>

                                <Canvas
                                    x:Name="PART_Canvas"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Height="30"
                                    VerticalAlignment="Center"
                                    ClipToBounds="True">

                                    <ItemsControl 
                                        x:Name="PART_ItemsHost" 
                                        ItemsSource="{TemplateBinding ItemsSource}"
                                        ItemTemplate="{TemplateBinding ItemTemplate}"
                                        ItemTemplateSelector="{TemplateBinding ItemTemplateSelector}">

                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <!-- 
                                                    Apply Padding to the Margin of the ItemsPanel.
                                                    RelativeSource is required because TemplateBinding does not work 
                                                    directly inside an ItemsPanelTemplate to reach the main Control. 
                                                -->
                                                <StackPanel 
                                                    Orientation="Horizontal" 
                                                    Margin="{Binding Padding, RelativeSource={RelativeSource AncestorType={x:Type local:MarqueeItemsControl}}}" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                                    </ItemsControl>
                                </Canvas>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
