{
  "$schema": "https://json.schemastore.org/appsettings.json",
  "DigitalTimers": {
    "Timers": [
      {
        "ModuleName": "Surgery Duration",
        "Measurement": {
          "Id": "timer-surgery-001",
          "Label": "Surgery",
          "Mode": "CountUp",
          "InitialSeconds": 0,
          "TargetSeconds": 7200,
          "AutoStart": false,
          "BlinkOnComplete": true,
          "UpdateIntervalMs": 1000,
          "IsLooping": false
        },
        "Display": {
          "DigitBrushHex": "#00FF41",
          "PlaceholderBrushHex": "#1A3320"
        }
      },
      {
        "ModuleName": "Tourniquet Timer",
        "Measurement": {
          "Id": "timer-tourniquet-001",
          "Label": "Tourniquet",
          "Mode": "CountUp",
          "InitialSeconds": 0,
          "TargetSeconds": 3600,
          "AutoStart": false,
          "BlinkOnComplete": true,
          "UpdateIntervalMs": 1000,
          "IsLooping": false
        },
        "Display": {
          "DigitBrushHex": "#FF6B35",
          "PlaceholderBrushHex": "#2A1A10"
        }
      },
      {
        "ModuleName": "Anesthesia Countdown",
        "Measurement": {
          "Id": "timer-anesthesia-001",
          "Label": "Anesthesia",
          "Mode": "CountDown",
          "InitialSeconds": 1800,
          "TargetSeconds": null,
          "AutoStart": false,
          "BlinkOnComplete": true,
          "UpdateIntervalMs": 1000,
          "IsLooping": false
        },
        "Display": {
          "DigitBrushHex": "#4FC3F7",
          "PlaceholderBrushHex": "#0D1F2A"
        }
      }
    ]
  },
  "DigitalSensors": {
    "Modules": [
      {
        "ModuleName": "Patient Vitals",
        "Measurements": [
          {
            "MeasurementId": "sensor-temp-001",
            "Type": "Temperature",
            "Unit": "°C",
            "LowWarningThreshold": 35.0,
            "HighWarningThreshold": 38.5
          },
          {
            "MeasurementId": "sensor-hr-001",
            "Type": "HeartRate",
            "Unit": "bpm",
            "LowWarningThreshold": 50.0,
            "HighWarningThreshold": 120.0
          }
        ],
        "Display": {
          "DigitBrush": "#00FF41",
          "PlaceholderBrush": "#1A3320"
        }
      },
      {
        "ModuleName": "OR Environment",
        "Measurements": [
          {
            "MeasurementId": "sensor-room-temp-001",
            "Type": "Temperature",
            "Unit": "°C",
            "LowWarningThreshold": 18.0,
            "HighWarningThreshold": 24.0
          },
          {
            "MeasurementId": "sensor-humidity-001",
            "Type": "Humidity",
            "Unit": "%",
            "LowWarningThreshold": 30.0,
            "HighWarningThreshold": 60.0
          }
        ],
        "Display": {
          "DigitBrush": "#B0B0B0",
          "PlaceholderBrush": "#2A2A2A"
        }
      }
    ]
  },
  "DigitalClock": {
    "WeatherUrl": "https://wttr.in/Tehran?format=j1",
    "ShowSeconds": true,
    "DateBrushHex": "#B0B0B0",
    "PlaceholderBrushHex": "#606060",
    "DigitBrushHex": "#FFFFFF"
  },
  "RssTicker": {
    "FeedUrls": [
      "https://www.irna.ir/rss/tp/14",
      "https://www.mehrnews.com/rss/dp/18"
    ],
    "RefreshIntervalMs": 600000,
    "ScrollSpeed": 50.0
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "SimurghDashboard": "Debug"
    }
  }
}
