<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:SimurghDashboard.Core.Controls"
    xmlns:controls1="clr-namespace:SimurghDashboard.Sensors.Controls"
    xmlns:infrastructures="clr-namespace:SimurghDashboard.Core.Infrastructures"
    xmlns:models="clr-namespace:SimurghDashboard.Sensors.Models">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SimurghDashboard;component/Core/Themes/Icons.xaml" />
        <ResourceDictionary Source="/SimurghDashboard;component/Core/Themes/Fonts.xaml" />
        <ResourceDictionary Source="/SimurghDashboard;component/Core/Themes/Images.xaml" />
    </ResourceDictionary.MergedDictionaries>


    <!--  Example ItemTemplate consumption inside DigitalSensorControl  -->
    <DataTemplate x:Key="MeasurableValueItemTemplate">
        <controls1:MeasurableValueControl
            ChannelIndex="{Binding ChannelIndex}"
            DigitBrush="{Binding StatusBrush}"
            IconData="{Binding Type, Converter={infrastructures:SensorIconConverter}}"
            Label="{Binding Label}"
            Unit="{Binding Unit}"
            ValueText="{Binding FormattedValue}" />
    </DataTemplate>



    <!--
        =====================================================================
        DIGITAL SENSOR CONTROL CONTAINER STYLE
        =====================================================================
        Card container providing module framing, title header, items list,
        and module operational state footer.
        =====================================================================
    -->
    <Style TargetType="{x:Type controls1:SensorControl}">
        <Setter Property="Padding" Value="40" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="ItemTemplate" Value="{StaticResource MeasurableValueItemTemplate}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls1:SensorControl}">
                    <Grid>
                        <!--  LAYER 1: Skeuomorphic 9-Slice Background Frame  -->
                        <controls:NineSliceBorder
                            x:Name="PART_Frame"
                            Margin="-10"
                            IsHitTestVisible="False"
                            SliceThickness="60"
                            Source="{StaticResource ImgPanelRoundedRaised}" />

                        <!--  LAYER 2: Container Content  -->
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  SECTION A: HEADER  -->
                            <StackPanel
                                Grid.Row="0"
                                Margin="0,0,0,15"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal">
                                <Path
                                    Width="24"
                                    Height="24"
                                    Margin="0,0,10,0"
                                    Data="{StaticResource IconSensor}"
                                    Fill="{TemplateBinding Foreground}"
                                    Stretch="Uniform" />
                                <TextBlock
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Foreground="{TemplateBinding Foreground}"
                                    Text="{TemplateBinding HeaderText}" />
                            </StackPanel>

                            <!--  SECTION B: MEASUREMENT LIST (ITEMS DELEGATION)  -->
                            <Border
                                Grid.Row="1"
                                Grid.RowSpan="2"
                                Padding="20,5"
                                Background="#CC000000"
                                BorderBrush="#33FFFFFF"
                                BorderThickness="1"
                                CornerRadius="8" />
                            <ItemsControl
                                Grid.Row="1"
                                Padding="5,5,5,0"
                                ItemTemplate="{TemplateBinding ItemTemplate}"
                                ItemTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                ItemsPanel="{TemplateBinding ItemsPanel}"
                                ItemsSource="{TemplateBinding ItemsSource}" />
                            <!--  SECTION C: FOOTER STATUS  -->
                            <StackPanel
                                Grid.Row="2"
                                Margin="0,0,0,5"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal">
                                <Ellipse
                                    x:Name="PART_StatusIndicator"
                                    Width="10"
                                    Height="10"
                                    Margin="0,0,8,0"
                                    Fill="#4CAF50" />
                                <TextBlock
                                    x:Name="PART_StateText"
                                    FontSize="14"
                                    FontWeight="Medium"
                                    Foreground="#4CAF50"
                                    Text="متصل" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!--  STATE-DRIVEN VISUAL TRIGGERS  -->
                    <ControlTemplate.Triggers>
                        <Trigger Property="State" Value="{x:Static models:ModuleState.Offline}">
                            <Setter TargetName="PART_StateText" Property="Text" Value="ارتباط قطع" />
                            <Setter TargetName="PART_StateText" Property="Foreground" Value="#F44336" />
                            <Setter TargetName="PART_StatusIndicator" Property="Fill" Value="#F44336" />
                        </Trigger>
                        <Trigger Property="State" Value="{x:Static models:ModuleState.Warning}">
                            <Setter TargetName="PART_StateText" Property="Text" Value="هشدار" />
                            <Setter TargetName="PART_StateText" Property="Foreground" Value="#FFC107" />
                            <Setter TargetName="PART_StatusIndicator" Property="Fill" Value="#FFC107" />
                        </Trigger>
                        <Trigger Property="State" Value="{x:Static models:ModuleState.Error}">
                            <Setter TargetName="PART_StateText" Property="Text" Value="خطر" />
                            <Setter TargetName="PART_StateText" Property="Foreground" Value="#E91E63" />
                            <Setter TargetName="PART_StatusIndicator" Property="Fill" Value="#E91E63" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
