<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls1="clr-namespace:SimurghDashboard.Sensors.Controls"
    xmlns:controls="clr-namespace:SimurghDashboard.Core.Controls"
    xmlns:sensors="clr-namespace:SimurghDashboard.Sensors.Controls.Sensors"
    xmlns:infrastructures="clr-namespace:SimurghDashboard.Core.Infrastructures">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SimurghDashboard;component/Themes/Icons.xaml" />
        <ResourceDictionary Source="/SimurghDashboard;component/Themes/Fonts.xaml" />
        <ResourceDictionary Source="/SimurghDashboard;component/Themes/Images.xaml" />
    </ResourceDictionary.MergedDictionaries>


    <!-- Example ItemTemplate consumption inside DigitalSensorControl -->
    <DataTemplate x:Key="MeasurableValueItemTemplate">
        <controls1:MeasurableValueControl
            ChannelIndex="{Binding ChannelIndex}"
            Label="{Binding Label}"
            IconData="{Binding Type, Converter={infrastructures:SensorIconConverter}}"
            ValueText="{Binding FormattedValue}"
            Unit="{Binding Unit}"
            DigitBrush="{Binding StatusBrush}" />
    </DataTemplate>



    <!--
        =====================================================================
        DIGITAL SENSOR CONTROL CONTAINER STYLE
        =====================================================================
        Card container providing module framing, title header, items list,
        and module operational state footer.
        =====================================================================
    -->
    <Style TargetType="{x:Type controls1:SensorControl}">
        <Setter Property="Padding" Value="40" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="ItemTemplate" Value="{StaticResource MeasurableValueItemTemplate}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls1:SensorControl}">
                    <Grid>
                        <!-- LAYER 1: Skeuomorphic 9-Slice Background Frame -->
                        <controls:NineSliceBorder
                            x:Name="PART_Frame"
                            IsHitTestVisible="False"
                            SliceThickness="60"
                            Source="{StaticResource ImgPanelRoundedRaised}" />

                        <!-- LAYER 2: Container Content -->
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- SECTION A: HEADER -->
                            <StackPanel
                                Grid.Row="0"
                                Margin="0,0,0,15"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal">
                                <Path
                                    Width="24"
                                    Height="24"
                                    Margin="0,0,10,0"
                                    Data="{StaticResource IconSensor}"
                                    Fill="{TemplateBinding Foreground}"
                                    Stretch="Uniform" />
                                <TextBlock
                                    FontSize="28"
                                    FontWeight="SemiBold"
                                    Foreground="{TemplateBinding Foreground}"
                                    Text="{TemplateBinding HeaderText}" />
                            </StackPanel>

                            <!-- SECTION B: MEASUREMENT LIST (ITEMS DELEGATION) -->
                            <Border
                                Grid.Row="1"
                                Padding="20,15"
                                Background="#CC000000"
                                BorderBrush="#33FFFFFF"
                                BorderThickness="1"
                                CornerRadius="8">
                                <ItemsControl
                                    ItemsSource="{TemplateBinding ItemsSource}"
                                    ItemTemplate="{TemplateBinding ItemTemplate}"
                                    ItemTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                    ItemsPanel="{TemplateBinding ItemsPanel}" />
                            </Border>

                            <!-- SECTION C: FOOTER STATUS -->
                            <StackPanel
                                Grid.Row="2"
                                Margin="0,15,0,0"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal">
                                <Ellipse
                                    x:Name="PART_StatusIndicator"
                                    Width="10"
                                    Height="10"
                                    Margin="0,0,8,0"
                                    Fill="#4CAF50" />
                                <TextBlock
                                    x:Name="PART_StateText"
                                    FontSize="14"
                                    FontWeight="Medium"
                                    Foreground="#4CAF50"
                                    Text="MODULE ONLINE" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- STATE-DRIVEN VISUAL TRIGGERS -->
                    <ControlTemplate.Triggers>
                        <Trigger Property="State" Value="{x:Static sensors:ModuleState.Offline}">
                            <Setter TargetName="PART_StateText" Property="Text" Value="MODULE OFFLINE" />
                            <Setter TargetName="PART_StateText" Property="Foreground" Value="#F44336" />
                            <Setter TargetName="PART_StatusIndicator" Property="Fill" Value="#F44336" />
                        </Trigger>
                        <Trigger Property="State" Value="{x:Static sensors:ModuleState.Warning}">
                            <Setter TargetName="PART_StateText" Property="Text" Value="MODULE WARNING" />
                            <Setter TargetName="PART_StateText" Property="Foreground" Value="#FFC107" />
                            <Setter TargetName="PART_StatusIndicator" Property="Fill" Value="#FFC107" />
                        </Trigger>
                        <Trigger Property="State" Value="{x:Static sensors:ModuleState.Error}">
                            <Setter TargetName="PART_StateText" Property="Text" Value="MODULE ERROR" />
                            <Setter TargetName="PART_StateText" Property="Foreground" Value="#E91E63" />
                            <Setter TargetName="PART_StatusIndicator" Property="Fill" Value="#E91E63" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
