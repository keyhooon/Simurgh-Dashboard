<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls1="clr-namespace:SimurghDashboard.Sensors.Controls"
    xmlns:infrastructures="clr-namespace:SimurghDashboard.Core.Infrastructures">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SimurghDashboard;component/Themes/Fonts.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        =====================================================================
        MEASURABLE VALUE CONTROL - THEME STYLE
        =====================================================================
        Self-contained display row with:
        [1] Icon geometry rendered via DigitBrush.
        [2] Overlaid 7-segment placeholder and live value.
        [3] Measurement unit aligned with baseline typography.
        =====================================================================
    -->
    <Style TargetType="{x:Type controls1:MeasurableValueControl}">
        <Setter Property="Margin" Value="0,5" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="DigitBrush" Value="#00E676" />
        <Setter Property="PlaceholderBrush" Value="#18FFFFFF" />
        <Setter Property="UnitBrush" Value="#707070" />
        <Setter Property="PlaceholderText" Value="88.8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls1:MeasurableValueControl}">
                    <Grid Margin="{TemplateBinding Margin}">
                        <Grid.ColumnDefinitions>
                            <!-- Column 0: Type Icon -->
                            <ColumnDefinition Width="40" />
                            <!-- Column 1: Label / Positional Channel Info (Optional) -->
                            <ColumnDefinition Width="Auto" />
                            <!-- Column 2: Digital Segment Readout -->
                            <ColumnDefinition Width="*" />
                            <!-- Column 3: Physical Measurement Unit -->
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- SECTION 1: SENSOR ICON -->
                        <Path
                            Grid.Column="0"
                            Width="26"
                            Height="26"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Data="{TemplateBinding IconData}"
                            Fill="{TemplateBinding DigitBrush}"
                            Stretch="Uniform" />

                        <!-- SECTION 2: OPTIONAL TEXT LABEL -->
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="5,0,10,0"
                            FontFamily="{StaticResource FontFamilyApp}"
                            FontSize="14"
                            FontWeight="Medium"
                            Foreground="{TemplateBinding UnitBrush}"
                            Text="{TemplateBinding Label}"
                            Visibility="{TemplateBinding Label, Converter={infrastructures:StringNullOrEmptyToVisibilityConverter}}" />

                        <!-- SECTION 3: 7-SEGMENT DIGIT OVERLAY -->
                        <Grid Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <!-- Background Placeholder Matrix -->
                            <TextBlock
                                FontFamily="{StaticResource FontFamilyDigit}"
                                FontSize="48"
                                FontWeight="ExtraBold"
                                Foreground="{TemplateBinding PlaceholderBrush}"
                                Text="{TemplateBinding PlaceholderText}" />

                            <!-- Active Telemetry Value -->
                            <TextBlock
                                FontFamily="{StaticResource FontFamilyDigit}"
                                FontSize="48"
                                FontWeight="ExtraBold"
                                Foreground="{TemplateBinding DigitBrush}"
                                Text="{TemplateBinding ValueText}" />
                        </Grid>

                        <!-- SECTION 4: PHYSICAL UNIT READOUT -->
                        <TextBlock
                            Grid.Column="3"
                            Margin="10,0,0,8"
                            VerticalAlignment="Bottom"
                            FontFamily="{StaticResource FontFamilyApp}"
                            FontSize="20"
                            FontWeight="Bold"
                            Foreground="{TemplateBinding UnitBrush}"
                            Text="{TemplateBinding Unit}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
