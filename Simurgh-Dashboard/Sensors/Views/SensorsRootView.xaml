<UserControl
    x:Class="SimurghDashboard.Sensors.Views.SensorsRootView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:coreControls="clr-namespace:SimurghDashboard.Core.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sensorControls="clr-namespace:SimurghDashboard.Sensors.Controls"
    xmlns:viewModels="clr-namespace:SimurghDashboard.Sensors.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewModels:SensorsRootViewModel}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  Implicit DataTemplate connecting SensorViewModel directly to the SensorControl  -->
        <DataTemplate DataType="{x:Type viewModels:SensorViewModel}">
            <sensorControls:SensorControl
                HeaderText="{Binding Title}"
                ItemsSource="{Binding MeasurableValues}"
                SlotIndex="{Binding Index}"
                State="{Binding State}" />
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <coreControls:WidgetFrame FrameVariant="RoundedSunkenLow">
            <ItemsControl ItemsSource="{Binding Sensors}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Margin" Value="10" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
            </ItemsControl>
        </coreControls:WidgetFrame>
    </Grid>
</UserControl>
