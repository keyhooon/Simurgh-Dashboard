<!--  1. SimurghDashboard/Resources/DataTemplates.xaml  -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:SimurghDashboard.Controls"
    xmlns:models="clr-namespace:SimurghDashboard.Services.Ticker.Models"
    xmlns:ticker="clr-namespace:SimurghDashboard.Services.Ticker"
    xmlns:viewmodels="clr-namespace:SimurghDashboard.ViewModels"
    xmlns:views="clr-namespace:SimurghDashboard.Views">

    <!--
        Implicit DataTemplates (No x:Key):
        WPF's presentation engine automatically uses these templates whenever it encounters
        the specified ViewModel type in the visual tree (e.g., assigned to a ContentControl.Content).
        This forms the backbone of View-Model decoupling in our MVVM architecture.
    -->

    <!--
        ============================================================
        Ticker Item Model Templates (resolved by type for MarqueeItemsControl)
        ============================================================
    -->

    <DataTemplate DataType="{x:Type models:RssItemModel}">
        <StackPanel Orientation="Horizontal">
            <TextBlock
                Margin="0,0,15,0"
                VerticalAlignment="Center"
                FontFamily="/SimurghDashboard;component/Fonts/#DSEG7 Classic"
                FontSize="14"
                Foreground="#FFB74D"
                Text="{Binding PublishDate, StringFormat='HH:mm'}" />

            <TextBlock
                VerticalAlignment="Center"
                FontFamily="/SimurghDashboard;component/Fonts/#Vazirmatn"
                FontSize="18"
                FontWeight="ExtraBold"
                Foreground="White">
                <Run Text="{Binding Title}" />
                <Run Foreground="AliceBlue" Text=" - " />
                <Run
                    FontWeight="Normal"
                    Foreground="White"
                    Text="{Binding Description}" />
            </TextBlock>

            <Path
                Width="6"
                Height="6"
                Margin="30,0,0,0"
                VerticalAlignment="Center"
                Data="M0,0 A3,3 0 1,1 0,6 A3,3 0 1,1 0,0 Z"
                Fill="#555"
                Stretch="Uniform" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type models:NotificationItemModel}">
        <StackPanel Orientation="Horizontal">
            <Border
                Margin="0,0,10,0"
                Padding="8,2"
                VerticalAlignment="Center"
                Background="#FFB74D"
                CornerRadius="4">
                <TextBlock
                    FontSize="12"
                    FontWeight="Bold"
                    Foreground="#1A1A1A"
                    Text="{Binding Source}" />
            </Border>

            <TextBlock
                VerticalAlignment="Center"
                FontSize="18"
                FontWeight="Bold"
                Foreground="White"
                Text="{Binding Message}" />

            <Path
                Width="6"
                Height="6"
                Margin="30,0,0,0"
                VerticalAlignment="Center"
                Data="M0,0 A3,3 0 1,1 0,6 A3,3 0 1,1 0,0 Z"
                Fill="#555"
                Stretch="Uniform" />
        </StackPanel>
    </DataTemplate>

    <!--  ============================================================  -->

    <DataTemplate DataType="{x:Type viewmodels:DigitalTimerViewModel}">
        <controls:DigitalTimerControl
            Margin="-20"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Configuration="{Binding Configuration}"
            DigitBrush="{Binding DigitBrush}"
            HeaderText="{Binding Label}"
            PlaceholderBrush="{Binding PlaceholderBrush}"
            RequestedAction="{Binding CurrentAction, Mode=TwoWay}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type viewmodels:DigitalSensorViewModel}">
        <controls:DigitalSensorControl
            Margin="-20"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Configuration="{Binding Configuration}"
            DigitBrush="{Binding DigitBrush}"
            HeaderText="{Binding Label}"
            PlaceholderBrush="{Binding PlaceholderBrush}"
            RawTelemetry="{Binding RawTelemetry}" />
    </DataTemplate>



    <DataTemplate DataType="{x:Type viewmodels:DigitalClockViewModel}">

        <controls:DigitalClockControl
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            DateBrush="{Binding DateBrush}"
            DigitBrush="{Binding DigitBrush}"
            PlaceholderBrush="{Binding PlaceholderBrush}"
            ShowSeconds="{Binding ShowSeconds}"
            WeatherState="{Binding WeatherState}" />

    </DataTemplate>

    <!--
        =============================================================================
        NEWLY ADDED TEMPLATES: Mapping the Parent ViewModels to their Collection Views
        =============================================================================
    -->

    <DataTemplate DataType="{x:Type viewmodels:DigitalTimersListViewModel}">
        <views:DigitalTimersListView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type viewmodels:DigitalSensorsListViewModel}">
        <views:DigitalSensorsListView Height="800" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type viewmodels:TickerViewModel}">
        <views:TickerView
            Height="150"
            Margin="-20"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch" />
    </DataTemplate>

</ResourceDictionary>
