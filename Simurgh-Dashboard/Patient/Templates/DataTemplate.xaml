<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors1="clr-namespace:SimurghDashboard.Core.Infrastructures.Behaviors"
    xmlns:controls2="clr-namespace:SimurghDashboard.Core.Controls"
    xmlns:converters="clr-namespace:SimurghDashboard.Core.Infrastructures.Converters"
    xmlns:vm="clr-namespace:SimurghDashboard.Patient.ViewModels">

    <!--  Merged Theme Resource Dictionaries  -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SimurghDashboard;component/Core/Themes/Icons.xaml" />
        <ResourceDictionary Source="/SimurghDashboard;component/Core/Themes/Fonts.xaml" />
        <ResourceDictionary Source="/SimurghDashboard;component/Core/Themes/Images.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  Boolean to Visibility Converter  -->
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <!--  Patient Demographic Minimal Vertical Card Template (Label-Free with Visual Hierarchy)  -->
    <DataTemplate DataType="{x:Type vm:PatientDemographicViewModel}">
        <Grid
            Margin="5"
            ClipToBounds="True"
            SnapsToDevicePixels="True"
            Visibility="{Binding IsAnyPropertyVisible, Converter={StaticResource BooleanToVisibilityConverter}}">

            <!--  LAYER 1: NineSlice Border Background Frame  -->
            <controls2:NineSliceBorder
                x:Name="PART_Frame"
                Margin="-15"
                IsHitTestVisible="False"
                SliceThickness="50"
                Source="{StaticResource ImgPanelRoundedRaised}" />

            <!--  LAYER 2: Internal Host Border  -->




            <Grid Margin="30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  =========================================================  -->
                <!--  Header: Patient Name & Biological Sex Badge  -->
                <!--  =========================================================  -->

                <!--  Primary Identifier: Full Name  -->
                <!--  Two-line cap via height clip + LineHeight, single newline feed truncation  -->
                <!--  MaxLines-enabled TextBlock consuming custom truncation behavior  -->
                <Path
                    Grid.Row="0"
                    Width="36"
                    Height="36"
                    HorizontalAlignment="left"
                    Data="{Binding Sex, Converter={converters:PatientSexIconConverter}}"
                    Fill="{Binding PrimaryBrush}"
                    Stretch="Uniform"
                    Visibility="{Binding IsSexVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock
                    Grid.Row="0"
                    HorizontalAlignment="Right"
                    FontFamily="{StaticResource FontFamilyApp}"
                    FontSize="32"
                    FontWeight="ExtraBold"
                    Foreground="{Binding PrimaryBrush}"
                    Text="{Binding PatientId, FallbackValue='--'}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{Binding IsPatientIdVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock
                    Grid.Row="1"
                    Margin="3"
                    VerticalAlignment="Center"
                    behaviors1:TextBlockTrimmingBehavior.MaxLines="2"
                    FlowDirection="RightToLeft"
                    FontFamily="{StaticResource FontFamilyApp}"
                    FontSize="36"
                    FontWeight="ExtraBold"
                    Foreground="{Binding PrimaryBrush}"
                    LineHeight="44"
                    LineStackingStrategy="BlockLineHeight"
                    Text="{Binding FullName, FallbackValue='--'}"
                    TextWrapping="Wrap"
                    Visibility="{Binding IsFullNameVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <!--  Date of Birth (Secondary Context)  -->
                <!--<TextBlock
                    Grid.Row="2"
                    Margin="0,0,0,6"
                    HorizontalAlignment="Right"
                    FlowDirection="RightToLeft"
                    FontFamily="{StaticResource FontFamilyApp}"
                    FontSize="32"
                    FontWeight="SemiBold"
                    Foreground="{Binding SecondaryBrush}"
                    Text="{Binding FormattedDateOfBirth}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{Binding IsDateOfBirthVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />-->

                <!--  Age (Tertiary Numeric Data)  -->
                <TextBlock
                    Grid.Row="2"
                    HorizontalAlignment="Left"
                    FlowDirection="RightToLeft"
                    FontFamily="{StaticResource FontFamilyApp}"
                    FontSize="32"
                    FontWeight="Bold"
                    Foreground="#EEEEEE"
                    Text="{Binding FormattedAge}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{Binding IsAgeVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock
                    Grid.Row="3"
                    MaxHeight="42"
                    Margin="0,0,0,8"
                    VerticalAlignment="Center"
                    behaviors1:TextBlockTrimmingBehavior.MaxLines="2"
                    FlowDirection="RightToLeft"
                    FontFamily="{StaticResource FontFamilyApp}"
                    FontSize="36"
                    FontWeight="ExtraBold"
                    Foreground="{Binding SecondaryBrush}"
                    LineHeight="44"
                    LineStackingStrategy="BlockLineHeight"
                    Text="{Binding ProcedureDisplay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap"
                    Visibility="{Binding IsProcedureVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock
                    Grid.Row="4"
                    MaxHeight="64"
                    FontFamily="{StaticResource FontFamilyApp}"
                    FontSize="36"
                    FontWeight="Medium"
                    Foreground="{Binding SecondaryBrush}"
                    Text="{Binding PhysicianDisplay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap"
                    Visibility="{Binding IsPhysicianVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />



            </Grid>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
