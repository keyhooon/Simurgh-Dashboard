<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls2="clr-namespace:SimurghDashboard.Core.Controls"
    xmlns:vm="clr-namespace:SimurghDashboard.Patient.ViewModels">

    <!-- Merged Theme Resource Dictionaries -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SimurghDashboard;component/Core/Themes/Icons.xaml" />
        <ResourceDictionary Source="/SimurghDashboard;component/Core/Themes/Fonts.xaml" />
        <ResourceDictionary Source="/SimurghDashboard;component/Core/Themes/Images.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Boolean to Visibility Converter -->
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <!-- Patient Demographic Minimal Vertical Card Template (Label-Free with Visual Hierarchy) -->
    <DataTemplate DataType="{x:Type vm:PatientDemographicViewModel}">
        <Grid
            Margin="5"
            ClipToBounds="True"
            SnapsToDevicePixels="True"
            Visibility="{Binding IsAnyPropertyVisible, Converter={StaticResource BooleanToVisibilityConverter}}">

            <!-- LAYER 1: NineSlice Border Background Frame -->
            <controls2:NineSliceBorder
                x:Name="PART_Frame"
                Margin="-15"
                IsHitTestVisible="False"
                SliceThickness="50"
                Source="{StaticResource ImgPanelRoundedRaised}" />

            <!-- LAYER 2: Internal Host Border -->
            <Border Padding="30,12,30,24">
                <StackPanel Orientation="Vertical">

                    <!-- ========================================================= -->
                    <!-- Header: Patient Name & Biological Sex Badge               -->
                    <!-- ========================================================= -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Primary Identifier: Full Name -->
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource FontFamilyApp}"
                            FontSize="17"
                            FontWeight="ExtraBold"
                            Foreground="{Binding PrimaryBrush}"
                            Text="{Binding Payload.FullName, FallbackValue='--'}"
                            TextWrapping="Wrap"
                            MaxHeight="46"
                            TextTrimming="CharacterEllipsis"
                            Visibility="{Binding IsFullNameVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <!-- Compact Biological Sex Badge -->
                        <Border
                            Grid.Column="1"
                            Margin="6,0,0,0"
                            Padding="7,2"
                            VerticalAlignment="Top"
                            Background="#20263238"
                            BorderBrush="{Binding PrimaryBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Visibility="{Binding IsSexVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock
                                FontFamily="{StaticResource FontFamilyDigit}"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="{Binding PrimaryBrush}"
                                Text="{Binding SexBadge}"
                                TextAlignment="Center" />
                        </Border>
                    </Grid>

                    <!-- ========================================================= -->
                    <!-- Section 1: Core Demographics Capsule                      -->
                    <!-- ========================================================= -->
                    <Border
                        Margin="0,0,0,10"
                        Padding="12,10"
                        Background="#CC000000"
                        BorderBrush="#33FFFFFF"
                        BorderThickness="1"
                        CornerRadius="5"
                        Visibility="{Binding HasDemographicVisibility, Converter={StaticResource BooleanToVisibilityConverter}}">

                        <StackPanel Orientation="Vertical">
                            <!-- Prominent Patient ID -->
                            <TextBlock
                                Margin="0,0,0,8"
                                FontFamily="{StaticResource FontFamilyDigit}"
                                FontSize="17"
                                FontWeight="ExtraBold"
                                Foreground="{Binding PrimaryBrush}"
                                Text="{Binding Payload.PatientId, FallbackValue='--'}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{Binding IsPatientIdVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <!-- Date of Birth (Secondary Context) -->
                            <TextBlock
                                Margin="0,0,0,6"
                                FontFamily="{StaticResource FontFamilyDigit}"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{Binding SecondaryBrush}"
                                Text="{Binding FormattedDateOfBirth}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{Binding IsDateOfBirthVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <!-- Age (Tertiary Numeric Data) -->
                            <TextBlock
                                FontFamily="{StaticResource FontFamilyDigit}"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="#EEEEEE"
                                Text="{Binding FormattedAge}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{Binding IsAgeVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>

                    <!-- ========================================================= -->
                    <!-- Section 2: Clinical Procedure & Physician Capsule         -->
                    <!-- ========================================================= -->
                    <Border
                        Padding="12,10"
                        Background="#CC000000"
                        BorderBrush="#33FFFFFF"
                        BorderThickness="1"
                        CornerRadius="5"
                        Visibility="{Binding HasProcedureVisibility, Converter={StaticResource BooleanToVisibilityConverter}}">

                        <StackPanel Orientation="Vertical">
                            <!-- Main Procedure Description -->
                            <TextBlock
                                Margin="0,0,0,8"
                                FontFamily="{StaticResource FontFamilyApp}"
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="#FFFFFF"
                                Text="{Binding ProcedureDisplay}"
                                TextWrapping="Wrap"
                                MaxHeight="42"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{Binding IsProcedureVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <!-- Accession Number / Study Identifier -->
                            <TextBlock
                                Margin="0,0,0,6"
                                FontFamily="{StaticResource FontFamilyDigit}"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{Binding PrimaryBrush}"
                                Text="{Binding AccessionDisplay}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{Binding IsAccessionNumberVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <!-- Attending / Performing Physician -->
                            <TextBlock
                                FontFamily="{StaticResource FontFamilyApp}"
                                FontSize="12"
                                FontWeight="Medium"
                                Foreground="{Binding SecondaryBrush}"
                                Text="{Binding PhysicianDisplay}"
                                TextWrapping="Wrap"
                                MaxHeight="36"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{Binding IsPhysicianVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
