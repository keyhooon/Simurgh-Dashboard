<Application
    x:Class="SimurghDashboard.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:http="clr-namespace:System.Net.Http;assembly=System.Net.Http"
    xmlns:services="clr-namespace:SimurghDashboard.Services"
    xmlns:simurghDashboard="clr-namespace:SimurghDashboard"
    xmlns:vm="clr-namespace:SimurghDashboard.ViewModels">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Colors.xaml" />
                <ResourceDictionary Source="/Themes/Fonts.xaml" />
                <ResourceDictionary Source="/Themes/Borders.xaml" />
                <ResourceDictionary Source="/Themes/Icons.xaml" />

            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

    </Application.Resources>

</Application>
