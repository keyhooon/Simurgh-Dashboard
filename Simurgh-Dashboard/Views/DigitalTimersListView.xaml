<!--  2. SimurghDashboard/Views/DigitalTimersListView.xaml  -->
<UserControl
    x:Class="SimurghDashboard.Views.DigitalTimersListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:SimurghDashboard.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:SimurghDashboard.ViewModels"
    Width="800"
    Height="450"
    d:DataContext="{d:DesignInstance Type=viewmodels:DigitalTimersListViewModel}"
    mc:Ignorable="d">

    <Grid Background="Transparent">
        <!--
            WidgetFrame adds the Neumorphic styling (RoundedSunkenLow) to the container.
            Negative margin helps offset inner paddings for flush alignment.
        -->
        <controls:WidgetFrame Margin="-10" FrameVariant="RoundedSunkenLow">

            <!--
                    ItemsControl avoids the heavy overhead of Selector controls (ListBox/ListView).
                    Since Kiosk dashboards do not need "SelectedItem" tracking or keyboard focus management
                    across items, ItemsControl is the most performant choice.
                    The 'Timers' binding is an ObservableCollection<DigitalTimerViewModel>.
            -->
            <ItemsControl Margin="20" ItemsSource="{Binding Timers}">

                <!--
                    ItemsPanel defines the spatial arrangement.
                    WrapPanel natively handles responsiveness. If the kiosk resolution changes
                    (e.g., Portrait to Landscape), the timers will flow horizontally and wrap
                    to the next row automatically.
                    Note: WrapPanel does not support UI Virtualization. If you ever scale to 100+ timers,
                    consider a VirtualizingWrapPanel implementation.
                -->
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <!--
                    ItemContainerStyle wraps each generated DataTemplate.
                    Instead of putting Margin="15" directly in the DigitalTimerControl DataTemplate,
                    we put it here. This keeps the atomic DigitalTimerControl completely unaware
                    of its spacing context, making it reusable elsewhere without weird layout side-effects.
                -->
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Margin" Value="15" />
                        <!--
                            We can hook into the 'Loaded' event via EventTrigger to stagger
                            the entrance animations of each timer, creating a cascade effect
                            when the dashboard boots up.
                        -->
                    </Style>
                </ItemsControl.ItemContainerStyle>

            </ItemsControl>

        </controls:WidgetFrame>
    </Grid>
</UserControl>
