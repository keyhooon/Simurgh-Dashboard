<!--
    Usage Example in a View (e.g., DashboardView.xaml)
    Assuming DataContext is set to TickerViewModel
-->
<UserControl
    x:Class="SimurghDashboard.Views.TickerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:SimurghDashboard.Controls"
    xmlns:views="clr-namespace:SimurghDashboard.Views">

    <!--  The Resources dictionary should include the TickerTemplates.xaml we created earlier  -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DataTemplates/TickerTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <!--
            TickerView binds directly to the ViewModel's properties.
            - ItemsSource: The ReadOnlyObservableCollection
            - ItemFinishedCommand: The auto-generated RelayCommand
            - SeparatorTemplate: Explicitly referenced from TickerTemplates.xaml
            - ItemSpacing / ScrollSpeed: Configured for optimal UX
        -->
        <controls:MarqueeItemsControl
            Height="50"
            Margin="50"
            VerticalAlignment="Bottom"
            Background="Aqua"
            Direction="LeftToRight"
            ItemTemplate="{StaticResource MarqueeRssItemTemplate}"
            ItemsSource="{Binding TickerStore}"
            ScrollSpeed="80"
            SeparatorTemplate="{StaticResource MarqueeSeparatorTemplate}" />
    </Grid>
</UserControl>